---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";

import GiftPage from "@astroComponents/pages/GiftPage/GiftPage.astro";
import GiftList from "@astroComponents/GiftList.astro";
import CategoryFilter from "@astroComponents/CategoryFilter.astro";
import Breadcrumbs from "@astroComponents/Breadcrumbs.astro";
import GiftNavigation from "@astroComponents/GiftNavigation.astro";

import AIPostBanner from '@reactComponents/AIPostBanner';

import RelatedProducts from "src/features/RelatedProducts";
import Ads from "src/features/Ads";

import { Image } from "astro:assets";
import { getLocaleFromUrl, getCleanSlug, getLangFromUrl, useTranslations, getLocaleFromSlug, useTranslatedPath } from "@i18n/utils";
import { ui } from "@i18n/ui";
import categoryTabs from "@i18n/translations/categoryTabs";

import { removeTrailingSlash } from "@utils/removeTrailingSlash";
import { getGifts, giftCategoryPath, giftsIndexPath } from "@utils/gifts";

const URL = Astro.url.pathname;
const lang = getLangFromUrl(URL);
const locale = getLocaleFromUrl(URL);
const t = useTranslations(lang, ui);

const pathname = removeTrailingSlash(URL);
const pathParts = pathname.split("/");
const activeGiftSlug = pathParts[pathParts.length - 1];

export async function getStaticPaths() {
  const giftsEntries = await getCollection("gifts");

  return giftsEntries.map((entry) => ({
    params: { lang: getLocaleFromSlug(entry.slug), slug: getCleanSlug(entry.slug), category: entry.data?.category },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const seoTitle = `${t("s.gift_idea")} ${t(entry.data.category)} - ${entry.data.title}`;

const translatePath = useTranslatedPath(locale);
const tCategory = useTranslations(lang, categoryTabs);
const categoryGifts = await getGifts(locale, entry.data.category);

const breadcrumbs = [
  { label: t("s.home"), href: translatePath("/") },
  { label: t("s.gift_ideas"), href: translatePath(giftsIndexPath()) },
  { label: tCategory(entry.data.category), href: translatePath(giftCategoryPath(entry.data.category)) },
  { label: entry.data.title },
];
---

<Layout title={seoTitle}>
  <Breadcrumbs items={breadcrumbs} />

  <GiftPage
    title={entry.data.title}
    subtitle={entry.data.description}
    category={t(entry.data.category)}
    categorySlug={entry.data.category}
    meta={entry.data?.meta}
    author={entry.data?.author}
    date={entry.data?.date}
    hasRelatedProducts={!!entry.data?.modules?.includes('RelatedProducts')}
  >
    <Image
      data-pagefind-meta="image[src]"
      class="img-cover"
      slot="thumbnail"
      src={entry.data.thumbnail}
      width="400"
      height="400"
      alt={entry.data.title}
    />

    { entry.data?.modules?.includes('RelatedProducts') && <RelatedProducts slot="related-products" refId={getCleanSlug(entry.slug)} lang={lang} locale={locale} client:load />}
    { entry.data?.modules?.includes('Ads') &&  <div slot="ads"><Ads /></div>}
    <Content slot="content" />
  </GiftPage>

  <GiftNavigation gifts={categoryGifts} current={entry} />

  <div class="categoryItems" slot="sidebar">
    <CategoryFilter activeCategory={entry.data.category}/>
    <GiftList gifts={categoryGifts} activeGiftSlug={activeGiftSlug}/>
  </div>

  { !entry.data?.author && <AIPostBanner lang={lang} />}
</Layout>

<style lang="scss">
  .categoryItems {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
</style>