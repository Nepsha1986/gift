---
import { getLangFromUrl, getLocaleFromUrl } from "../i18n/utils";
import { removeTrailingSlash } from "../utils/removeTrailingSlash";

import LangSwitcher from "../components/react/LangSwitcher";
import Navigation from "../components/react/Navigation";
import LogoDark from "../components/react/LogoDark";
import MobileMenu from "../components/react/MobileMenu";
import Search from "../components/react/Search";

const URL = Astro.url.pathname;

const locale = getLocaleFromUrl(URL);
const lang = getLangFromUrl(URL);
const pathname = removeTrailingSlash(URL);
---

<header id="website_header" class="header">
  <div class="header__container">
    <a class="header__logo" href={`/${locale}`} aria-label="Gift Idea">
      <LogoDark />
    </a>

    <div class="header__nav">
      <Navigation currentPage={pathname} />
    </div>

    <div class="header__rightSlot">
      <Search client:load lang={lang} />
      <LangSwitcher pathname={pathname} />
    </div>

    <div class="header__mobileNav">
      <Search client:load lang={lang} compact />
      <MobileMenu client:load>
        <Navigation currentPage={pathname} slot="navigation" type="mobile" />
        <LangSwitcher pathname={pathname} slot="footer" variant="list" />
      </MobileMenu>
    </div>
  </div>
</header>

<style lang="scss">
	.header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 10px var(--gutter) 0;

		&__container {
			position: relative;
			isolation: isolate;
			height: calc(var(--header-height) - 10px);
			padding: 0 10px 0 22px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 1rem;
			max-width: calc(var(--container) - 2 * var(--gutter));
			margin: 0 auto;
			border: 1px solid transparent;
			border-radius: var(--radius-full);
			transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);

			// Blur lives on a pseudo-element: backdrop-filter on the bar itself
			// would become the containing block of the fixed mobile menu.
			&::before {
				content: "";
				position: absolute;
				inset: 0;
				z-index: -1;
				border-radius: inherit;
				background: rgba(255, 253, 249, 0);
				transition: background-color 0.25s var(--ease);
			}
		}

		// Once the page scrolls the header becomes a floating "island"
		&_scrolled &__container {
			border-color: var(--c-border);
			box-shadow: var(--shadow-md);

			&::before {
				background: rgba(255, 253, 249, 0.82);
				backdrop-filter: saturate(180%) blur(14px);
				-webkit-backdrop-filter: saturate(180%) blur(14px);
			}
		}

		&__logo {
			display: block;
			width: 138px;
			flex-shrink: 0;
			transition: transform 0.3s var(--ease-bounce);

			&:hover {
				transform: rotate(-3deg) scale(1.03);
			}

			:global(svg) {
				display: block;
			}
		}

		&__rightSlot {
			display: none;

			@media screen and (min-width: 960px) {
				display: flex;
				align-items: center;
				gap: 6px;
			}
		}

		&__nav {
			display: none;

			@media screen and (min-width: 960px) {
				display: block;
			}
		}

		&__mobileNav {
			display: flex;
			align-items: center;
			gap: 4px;

			@media screen and (min-width: 960px) {
				display: none;
			}
		}

		@media (max-width: 959px) {
			&__container {
				padding: 0 6px 0 16px;
			}

			&__logo {
				width: 124px;
			}
		}
	}
</style>

<script>
  // Registered once: the header is persisted between view transitions.
  let ticking = false;

  const update = (): void => {
    document
      .getElementById("website_header")
      ?.classList.toggle("header_scrolled", window.scrollY > 4);
    ticking = false;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true },
  );
  document.addEventListener("astro:page-load", update);
</script>
