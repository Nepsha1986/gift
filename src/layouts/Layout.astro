---
import Head from "./Head.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { ui } from "@i18n/ui";

import "../styles/global.scss";

interface Props {
	title: string;
	isLanding?: boolean;
	hasHeader?: boolean;
	hasFooter?: boolean;
}

const URL = Astro.url.pathname;

const {title, isLanding, hasHeader = true, hasFooter = true} = Astro.props;
const lang = getLangFromUrl(URL);
const t = useTranslations(lang, ui);

const hasSidebar = !!Astro.slots.has('sidebar');
---

<!doctype html>
<html lang={lang}>
<Head title={title}/>
<body class='body' id="body">
{hasHeader &&
  <Header transition:persist />}
{isLanding ?
  <main>
    <slot/>
  </main> : (
    <div class:list={['app', {app_hasSidebar: hasSidebar}]}>
      <main class="app__main">
        <slot/>
      </main>

			{hasSidebar && (
        <Fragment>
          <aside id='sidebar' class="app__sidebar" data-pagefind-ignore="all">
            <slot name='sidebar'/>
          </aside>
          <div class="app__sidebarOverlay" id="sidebar_overlay"></div>
          <button class="app__sidebarToggleBtn" id='sidebar_toggle' type="button" aria-controls="sidebar" aria-expanded="false">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1.5"/><rect x="9" y="1" width="6" height="6" rx="1.5"/><rect x="1" y="9" width="6" height="6" rx="1.5"/><rect x="9" y="9" width="6" height="6" rx="1.5"/></svg>
            {t("s.view_all_ideas")}
          </button>
        </Fragment>
			)}
    </div>
	)}
{hasFooter &&
  <Footer/>}
</body>
</html>

<style lang="scss">
	.body {
		display: flex;
		flex-direction: column;

		&_noScroll {
			overflow: hidden;
		}
	}

	main {
		flex-grow: 1;
	}

	.app {
		$this: &;

		width: 100%;
		max-width: var(--container);
		flex-grow: 1;
		padding: 2.5rem var(--gutter) 0;
		margin: 0 auto;

		&_hasSidebar {
			display: flex;
			align-items: flex-start;
			gap: 40px;

			#{$this}__main {
				min-width: 0;
				width: 100%;
				flex-grow: 1;
			}

			#{$this}__sidebar {
				padding: 1.25rem 1rem;
				width: min(380px, 90vw);
				position: fixed;
				top: 0;
				right: 0;
				height: 100dvh;
				overflow-y: auto;
				background: var(--c-bg);
				box-shadow: var(--shadow-lg);
				z-index: 9999;
				transform: translateX(105%);
				visibility: hidden;
				transition: transform 0.3s var(--ease), visibility 0s linear 0.3s;

				@media (min-width: 1200px) {
					position: sticky;
					top: calc(var(--header-height) + 16px);
					height: auto;
					max-height: calc(100vh - var(--header-height) - 32px);
					width: 360px;
					flex-shrink: 0;
					padding: 0;
					background: transparent;
					box-shadow: none;
					transform: none;
					visibility: visible;
					overflow: visible;
					z-index: 1;
				}
			}

			#{$this}__sidebar_active {
				transform: translateX(0);
				visibility: visible;
				transition: transform 0.3s var(--ease), visibility 0s;
			}

			#{$this}__sidebarOverlay {
				position: fixed;
				inset: 0;
				z-index: 9998;
				background: rgba(36, 17, 43, 0.45);
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.3s var(--ease);

				&_active {
					opacity: 1;
					pointer-events: auto;
				}
			}

			#{$this}__sidebarToggleBtn {
				position: fixed;
				right: 16px;
				bottom: 16px;
				z-index: 9;
				display: inline-flex;
				align-items: center;
				gap: 8px;
				height: 46px;
				padding: 0 20px;
				font-size: 0.9rem;
				font-weight: 600;
				color: #fff;
				background: var(--c-primary);
				border: 1px solid var(--c-border);
				border-radius: var(--radius-full);
				box-shadow: var(--shadow-pop);
				cursor: pointer;

				@media (min-width: 1200px) {
					display: none;
				}
			}
		}
	}
</style>

<script is:inline>
	document.addEventListener('astro:page-load', () => {
		const button = document.querySelector('#sidebar_toggle');
		const sidebar = document.querySelector('#sidebar');
		const overlay = document.querySelector('#sidebar_overlay');
		const body = document.querySelector('#body');

		if (!button || !sidebar) return;

		const toggle = () => {
			const isActive = sidebar.classList.toggle('app__sidebar_active');
			overlay?.classList.toggle('app__sidebarOverlay_active', isActive);
			body.classList.toggle('body_noScroll', isActive);
			button.setAttribute('aria-expanded', String(isActive));
		};

		button.addEventListener('click', toggle);
		overlay?.addEventListener('click', toggle);
	}, {once: false});
</script>
