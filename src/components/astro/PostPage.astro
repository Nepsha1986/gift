---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { ui } from "@i18n/ui";
import { formatDate } from "@utils/formatDate";
import { authors } from "src/content/_authors";
import { AuthorID } from "src/types/author";

import ShareBlock from "./ShareBlock/ShareBlock.astro";

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang, ui);

interface Props {
  thumbnail: string;
  title: string;
  subtitle: string;
  content: any;
  author?: AuthorID;
  date?: string;
}

const { thumbnail, title, content, subtitle, meta, author, date } = Astro.props;
---

<article class="post" data-pagefind-body>
  <header class="post__header">
    <div class="post__headerInfo">
      <h1 class="post__title">{title}</h1>
      <p class="post__subtitle">{subtitle}</p>

      {author && (
        <div class="post__authorBlock">
          <div class="post__authorImage">
            <Image src={authors[author].photo} alt={authors[author].fullName} width="96" height="96" />
          </div>

          <div class="post__authorMeta">
            <address class="post__author">
              <a rel="author" target="_blank" href={authors[author].link}>{authors[author].fullName}</a>
            </address>
            {date && <time datetime={date}>{formatDate(date)}</time>}
          </div>
        </div>
      )}
    </div>

    <div class="post__imgWrap">
      <slot name="thumbnail" class="post__img" />
    </div>
  </header>

  <div class="post__content prose">
    <slot name="content" />
  </div>

  <aside class="post__aside">
    <ShareBlock />
  </aside>
</article>

<style lang="scss">
	.post {
		max-width: 1000px;
		margin: 0 auto;

		&__header {
			margin-bottom: 2.5rem;
		}

		&__headerInfo {
			margin: 0 auto 2rem;
			max-width: 760px;
			text-align: center;
		}

		&__title {
			font-size: clamp(1.75rem, 4.5vw, 3rem);
			font-weight: 800;
			letter-spacing: -0.035em;
			line-height: 1.1;
			margin-bottom: 1rem;
		}

		&__subtitle {
			color: var(--c-grey);
			font-size: clamp(1.05rem, 1.6vw, 1.25rem);
			line-height: 1.6;
			margin-bottom: 1.5rem;
		}

		&__authorBlock {
			display: inline-flex;
			align-items: center;
			gap: 12px;
			text-align: left;
		}

		&__authorImage {
			flex-shrink: 0;
			overflow: hidden;
			width: 44px;
			height: 44px;
			border-radius: 50%;
			box-shadow: 0 0 0 2px var(--c-surface), 0 0 0 3px var(--c-border);

			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
		}

		&__authorMeta {
			display: flex;
			flex-direction: column;
			font-size: 0.875rem;
			line-height: 1.35;
			color: var(--c-grey);
		}

		&__author {
			font-style: normal;
			font-weight: 600;
			margin: 0;
		}

		&__imgWrap {
			overflow: hidden;
			aspect-ratio: 16 / 8;
			border-radius: var(--radius-lg);
			background: var(--c-grey-lightest);
		}

		&__content {
			max-width: 720px;
			margin: 0 auto;
		}

		&__aside {
			max-width: 720px;
			border-top: 1px solid var(--c-border);
			margin: 3rem auto 0;
			padding: 1.5rem 0 0;
		}
	}
</style>
