---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { ui } from "@i18n/ui";
import { formatDate } from "@utils/formatDate";
import { authors } from "src/content/_authors";
import { AuthorID } from "src/types/author";

import ShareBlock from "./ShareBlock/ShareBlock.astro";

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang, ui);

interface Props {
  thumbnail: string;
  title: string;
  subtitle: string;
  content: any;
  author?: AuthorID;
  date?: string;
}

const { thumbnail, title, content, subtitle, meta, author, date } = Astro.props;
---

<div class="readingProgress" id="reading_progress" aria-hidden="true"></div>

<article class="post" data-pagefind-body>
  <header class="post__header">
    <div class="post__headerInfo">
      <h1 class="post__title">{title}</h1>
      <p class="post__subtitle">{subtitle}</p>

      {author && (
        <div class="post__authorBlock">
          <div class="post__authorImage">
            <Image src={authors[author].photo} alt={authors[author].fullName} width="96" height="96" />
          </div>

          <div class="post__authorMeta">
            <address class="post__author">
              <a rel="author" target="_blank" href={authors[author].link}>{authors[author].fullName}</a>
            </address>
            {date && <time datetime={date}>{formatDate(date)}</time>}
          </div>
        </div>
      )}
    </div>

    <div class="post__imgWrap">
      <slot name="thumbnail" class="post__img" />
    </div>
  </header>

  <div class="post__content prose">
    <slot name="content" />
  </div>

  <aside class="post__aside">
    <ShareBlock />
  </aside>
</article>

<style lang="scss">
	.readingProgress {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 11;
		width: 100%;
		height: 4px;
		background: var(--c-primary);
		transform-origin: 0 50%;
		transform: scaleX(var(--progress, 0));
	}

	.post {
		max-width: 1040px;
		margin: 0 auto;

		&__header {
			margin-bottom: clamp(2rem, 5vw, 3.5rem);
		}

		&__headerInfo {
			margin: 0 auto clamp(2rem, 4vw, 2.75rem);
			max-width: 820px;
			text-align: center;
		}

		&__title {
			font-size: clamp(2rem, 5.2vw, 3.6rem);
			font-weight: 700;
			letter-spacing: -0.05em;
			line-height: 1.04;
			margin-bottom: 1.25rem;
		}

		&__subtitle {
			max-width: 680px;
			margin: 0 auto 1.75rem;
			color: var(--c-grey-dark);
			font-size: clamp(1.05rem, 1.6vw, 1.25rem);
			line-height: 1.6;
		}

		&__authorBlock {
			display: inline-flex;
			align-items: center;
			gap: 12px;
			padding: 6px 18px 6px 6px;
			text-align: left;
			background: var(--c-surface);
			border: 1px solid var(--c-border);
			border-radius: var(--radius-full);
		}

		&__authorImage {
			flex-shrink: 0;
			overflow: hidden;
			width: 42px;
			height: 42px;
			border-radius: 50%;

			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
		}

		&__authorMeta {
			display: flex;
			flex-direction: column;
			font-size: 0.85rem;
			line-height: 1.35;
			color: var(--c-grey);
		}

		&__author {
			font-style: normal;
			font-weight: 700;
			margin: 0;

			a {
				color: var(--c-ink);

				&:hover {
					color: var(--c-primary-dark);
				}
			}
		}

		&__imgWrap {
			overflow: hidden;
			aspect-ratio: 16 / 8;
			border: 2px solid var(--c-ink);
			border-radius: var(--radius-xl);
			box-shadow: 8px 8px 0 var(--c-ink);
			background: var(--c-grey-lightest);

			@media (max-width: 640px) {
				aspect-ratio: 4 / 3;
				box-shadow: 5px 5px 0 var(--c-ink);
			}
		}

		&__content {
			max-width: 720px;
			margin: 0 auto;
		}

		&__aside {
			max-width: 720px;
			margin: 3rem auto 0;
		}
	}
</style>

<script>
  // Thin progress bar showing how far the article has been read
  const update = (): void => {
    const bar = document.getElementById("reading_progress");
    const article = document.querySelector<HTMLElement>(".post");
    if (!bar || !article) return;

    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const progress = total > 0 ? Math.min(Math.max(-rect.top / total, 0), 1) : 1;
    bar.style.setProperty("--progress", String(progress));
  };

  window.addEventListener("scroll", update, { passive: true });
  document.addEventListener("astro:page-load", update);
</script>
