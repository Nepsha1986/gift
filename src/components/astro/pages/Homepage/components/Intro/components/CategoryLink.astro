---
const { link } = Astro.props;
---
<a class="category" href={link}>
  <div class="category__imgWrap">
    <slot name="img" />
  </div>

  <div class="category__text">
    <slot />
    <span class="category__arrow" aria-hidden="true">→</span>
  </div>
</a>

<style is:global>
	.category__text strong {
		color: var(--c-primary-dark);
	}
</style>

<style lang="scss">
	.category {
		display: flex;
		flex-direction: column;
		width: 100%;
		background: var(--c-surface);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		transition: box-shadow 0.25s var(--ease), transform 0.25s var(--ease), border-color 0.25s var(--ease);

		&:hover {
			transform: translateY(-3px);
			box-shadow: var(--shadow-lg);
			border-color: transparent;

			.category__arrow {
				transform: translateX(3px);
				color: var(--c-primary);
			}
		}

		&__imgWrap {
			aspect-ratio: 4 / 3;
			overflow: hidden;
			background: var(--c-grey-lightest);
		}

		@media (max-width: 559px) {
			flex-direction: row;
			align-items: center;

			&__imgWrap {
				flex-shrink: 0;
				width: 96px;
				aspect-ratio: 1 / 1;
			}
		}

		&__text {
			position: relative;
			flex-grow: 1;
			padding: 1rem 2.75rem 1.1rem 1.1rem;
			font-size: 0.95rem;
			line-height: 1.5;
			color: var(--c-grey-dark);
		}

		&__arrow {
			position: absolute;
			right: 1.1rem;
			bottom: 1rem;
			font-size: 1.1rem;
			color: var(--c-grey-light);
			transition: transform 0.2s var(--ease), color 0.2s var(--ease);
		}
	}
</style>
