---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import CategoryLink from "./components/CategoryLink.astro";

import { useTranslatedPath, getLocaleFromUrl, getLangFromUrl, getLocaleFromSlug, useTranslations } from "@i18n/utils";
import translations from "./translations";

import { categoryLinks } from "@utils/categoryLinks";
import { authors } from "@src/content/_authors";
import type { Category } from "@src/types/category";

import manImg from "@src/assets/man.webp";
import womanImg from "@src/assets/woman.webp";
import teenImg from "@src/assets/teen.webp";
import kidImg from "@src/assets/kid.webp";

const URL = Astro.url.pathname;

const locale = getLocaleFromUrl(URL);
const lang = getLangFromUrl(URL);
const translatePath = useTranslatedPath(locale);

const t = useTranslations(lang, translations);

const ideasCount = (await getCollection("gifts", ({ slug }) => getLocaleFromSlug(slug) === locale)).length;
// Round down to a friendly "80+" style number
const ideasLabel = `${Math.max(10, Math.floor(ideasCount / 10) * 10)}+`;

const recipients: Array<{ category: Category; key: "women" | "men" | "teens" | "kids"; img: ImageMetadata }> = [
  { category: "for-women", key: "women", img: womanImg },
  { category: "for-men", key: "men", img: manImg },
  { category: "for-teens", key: "teens", img: teenImg },
  { category: "for-kids", key: "kids", img: kidImg },
];

const editors = [authors.alex_nepsha, authors.polina_gordienko, authors.olga_sergeevna];
const occasions = t("intro.occasions").split("|");
---

<section class="intro">
  <div class="intro__container">
    <div class="intro__content">
      <span class="intro__badge">
        <span class="intro__badgeDot" aria-hidden="true"></span>
        <strong>{ideasLabel}</strong> {t("intro.badge")}
      </span>

      <h1 class="intro__heading" set:html={t("intro.heading")} />

      <p class="intro__text">{t("intro.text")}</p>

      <div class="intro__actions">
        <a class="intro__cta" href="#ideas">
          {t("intro.cta")}
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v10m0 0 4.5-4.5M8 13 3.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="intro__ctaSecondary" href={translatePath("/posts")}>{t("intro.cta_secondary")}</a>
      </div>

      <div class="intro__editors">
        <div class="intro__avatars">
          {editors.map((a) => (
            <Image src={a.photo} alt={a.fullName} width={72} height={72} />
          ))}
        </div>
        <span>{t("intro.editors")}</span>
      </div>
    </div>

    <div class="intro__picker">
      <p class="intro__pickerLabel">
        {t("intro.picker")}
      </p>

      <ul class="intro__categoryLinks">
        {recipients.map((r) => (
          <li class="intro__categoryLink">
            <CategoryLink link={translatePath(categoryLinks[r.category])} category={r.category} title={t(`cat.${r.key}.title`)}>
              {t(`cat.${r.key}`)}
              <Image class="img-cover" width={400} height={320} slot="img" src={r.img} alt="" loading="eager" />
            </CategoryLink>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Decorative ribbon of occasions -->
  <div class="ribbon" aria-hidden="true">
    <div class="ribbon__track">
      {[0, 1].map(() => (
        <div class="ribbon__group">
          {occasions.map((o) => (
            <Fragment>
              <span>{o}</span>
              <span class="ribbon__dot"></span>
            </Fragment>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
	.intro {
		position: relative;
		overflow-x: clip;
		isolation: isolate;

		// Soft festive glows behind the hero
		&::before,
		&::after {
			content: "";
			position: absolute;
			z-index: -1;
			border-radius: 50%;
			filter: blur(90px);
			pointer-events: none;
		}

		&::before {
			width: 560px;
			height: 560px;
			top: -260px;
			right: -140px;
			background: rgba(255, 154, 127, 0.4);
		}

		&::after {
			width: 460px;
			height: 460px;
			top: 220px;
			left: -260px;
			background: rgba(253, 214, 226, 0.6);
		}

		&__container {
			max-width: var(--container);
			padding: clamp(2rem, 6vw, 4.5rem) var(--gutter) clamp(3rem, 6vw, 5rem);
			margin: 0 auto;
			display: grid;
			gap: clamp(2.5rem, 5vw, 4rem);
			align-items: center;

			@media (min-width: 1040px) {
				grid-template-columns: 1.05fr 1fr;
			}
		}

		&__badge {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			margin-bottom: 1.5rem;
			padding: 6px 14px 6px 10px;
			font-size: 0.875rem;
			font-weight: 500;
			color: var(--c-grey-dark);
			background: var(--c-surface);
			border: 1px solid var(--c-border);
			border-radius: var(--radius-full);
			box-shadow: var(--shadow-sm);

			strong {
				color: var(--c-primary-dark);
			}
		}

		&__badgeDot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: var(--c-primary);
			box-shadow: 0 0 0 4px var(--c-primary-lightest);
			animation: pulse 2s var(--ease) infinite;
		}

		&__heading {
			font-size: clamp(2.3rem, 6.4vw, 4.6rem);
			font-weight: 800;
			letter-spacing: -0.045em;
			line-height: 1.04;
			margin-bottom: 1.5rem;
		}

		&__text {
			max-width: 540px;
			color: var(--c-grey-dark);
			font-size: clamp(1.05rem, 1.6vw, 1.2rem);
			line-height: 1.6;
			margin-bottom: 2rem;
		}

		&__actions {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 12px 20px;
			margin-bottom: 2.25rem;
		}

		&__cta {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			height: 56px;
			padding: 0 30px;
			font-size: 1.05rem;
			font-weight: 600;
			color: #fff;
			background: var(--c-primary);
			border-radius: var(--radius-full);
			box-shadow: var(--shadow-primary);
			transition:
				transform 0.25s var(--ease),
				box-shadow 0.25s var(--ease),
				background-color 0.2s var(--ease);

			&:hover {
				color: #fff;
				background: var(--c-primary-dark);
				transform: translateY(-2px);
				box-shadow: 0 14px 30px -10px rgba(214, 54, 27, 0.6);
			}
		}

		&__ctaSecondary {
			display: inline-flex;
			align-items: center;
			height: 56px;
			padding: 0 26px;
			font-weight: 600;
			color: var(--c-ink);
			background: var(--c-surface);
			border: 1px solid var(--c-border);
			border-radius: var(--radius-full);
			box-shadow: var(--shadow-sm);
			transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);

			&:hover {
				color: var(--c-ink);
				border-color: var(--c-grey-light);
				box-shadow: var(--shadow-md);
			}
		}

		&__editors {
			display: flex;
			align-items: center;
			gap: 12px;
			font-size: 0.9rem;
			color: var(--c-grey);
		}

		&__avatars {
			display: flex;

			:global(img) {
				width: 36px;
				height: 36px;
				object-fit: cover;
				border-radius: 50%;
				border: 2px solid var(--c-bg);

				&:not(:first-child) {
					margin-left: -10px;
				}
			}
		}

		&__picker {
			position: relative;
		}

		&__pickerLabel {
			display: flex;
			align-items: flex-end;
			gap: 6px;
			margin-bottom: 1rem;
			font-family: var(--font-secondary);
			font-size: 1.1rem;
			font-weight: 700;
			color: var(--c-ink);
		}


		&__categoryLinks {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			gap: 16px;
			grid-template-columns: repeat(2, 1fr);

			@media (max-width: 559px) {
				grid-template-columns: 1fr;
				gap: 14px;
			}
		}

		&__categoryLink {
			margin: 0;
			display: flex;
		}
	}

	// Calm, straight band of occasions
	.ribbon {
		position: relative;
		z-index: 1;
		padding: 18px 0;
		overflow: hidden;
		color: var(--c-grey-dark);
		background: var(--c-surface);
		border-block: 1px solid var(--c-border);
		mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);

		&__track {
			display: flex;
			width: max-content;
			animation: marquee 45s linear infinite;
		}

		&__group {
			display: flex;
			align-items: center;
			gap: 32px;
			padding-right: 32px;
			font-family: var(--font-secondary);
			font-size: clamp(1rem, 1.8vw, 1.25rem);
			font-weight: 700;
			letter-spacing: -0.01em;
			white-space: nowrap;
		}

		&__dot {
			width: 6px;
			height: 6px;
			flex-shrink: 0;
			border-radius: 50%;
			background: var(--gradient-accent);
		}
	}

	@keyframes marquee {
		to {
			transform: translateX(-50%);
		}
	}

	@keyframes pulse {
		50% {
			box-shadow: 0 0 0 7px rgba(214, 54, 27, 0.12);
		}
	}
</style>
