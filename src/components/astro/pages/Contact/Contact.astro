---
import Layout from 'src/layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import translations from "./translations";

import ContactForm from "@reactComponents/ContactForm";
const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang, translations)
---

<Layout title={t("page.title")}>
  <div class="formBlock">
    <header class="formBlock__header">
      <h1 class="formBlock__title">{t("page.heading")}</h1>
    </header>

    <div class="formBlock__container">
      <h2 class="formBlock__formTitle">{t("form.title")}</h2>

      <p class="formBlock__subtitle">{t("form.subtitle")}</p>

      <ContactForm client:load lang={lang} />
    </div>
  </div>
</Layout>

<style lang="scss">
	.formBlock {
		max-width: 640px;
		margin: 0 auto;

		&__header {
			text-align: center;
			margin-bottom: 2rem;
		}

		&__title {
			font-size: clamp(2rem, 5vw, 3.25rem);
			font-weight: 700;
			letter-spacing: -0.045em;
			margin: 0;
		}

		&__container {
			position: relative;
			background: var(--c-surface);
			padding: clamp(1.5rem, 4vw, 2.5rem);
			border: 2px solid var(--c-ink);
			border-radius: var(--radius-xl);
			box-shadow: 8px 8px 0 var(--c-ink);

			// Little bow sticker on the corner of the "gift box" form
			&::before {
				content: "";
				position: absolute;
				top: -26px;
				right: 28px;
				width: 56px;
				height: 56px;
				background: url("/favicon.svg") center / contain no-repeat;
				transform: rotate(12deg);
			}
		}

		&__formTitle {
			font-size: 1.35rem;
			margin-bottom: 0.5rem;
		}

		&__subtitle {
			color: var(--c-grey);
			margin-bottom: 1.75rem;
		}
	}
</style>
