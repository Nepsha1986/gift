---
import { Category } from "@src/types/category";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { ui } from "@i18n/ui";
import { formatDate } from "@utils/formatDate";
import { authors } from "@src/content/_authors";
import ShareBlock from "@src/components/astro/ShareBlock/ShareBlock.astro";

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang, ui);
interface MetaInfo {
  age: string,
  priceRange: string,
}

type Author = {
  fullName: string;
  link: string;
}
interface Props {
  thumbnail: string;
  title: string;
  subtitle: string;
  content: any;
  category?: Category;
  meta?: MetaInfo;
  author?: Author;
  date?: string;
  hasRelatedProducts?: boolean;
}

const { thumbnail, title, content, category, meta, author, date, hasRelatedProducts = false } = Astro.props;
---

<article class="article" data-pagefind-body>
  <header class="article__header">
    <div class="article__imgWrap">
      <slot name="thumbnail" class="article__img" />
    </div>

    <div class="article__headerInfo">
      <div>
        {category && <span class="article__category">{category}</span>}
        <h1 class="article__title">{title}</h1>
        {author &&
          <div class="article__authorBlock">
            <address class="article__author">{t("s.by")} <a rel="author" href={authors[author].link}>{authors[author].fullName}</a></address>
            <span aria-hidden="true">·</span>
            <time datetime={date}>{formatDate(date)}</time>
          </div>
        }
      </div>

      {hasRelatedProducts && (
        <div class="article__related">
          <slot name="related-products" />
        </div>
      )}
    </div>
  </header>

  <slot name="ads" />

  <div class="article__content prose">
    <slot name="content" />
  </div>

  <aside class="article__aside">
    <ShareBlock />
  </aside>
</article>

<style lang="scss">
	.article {
		max-width: 820px;

		&__header {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			margin-bottom: 2.5rem;
			padding: 12px;
			background: var(--c-surface);
			border: 1px solid var(--c-border);
			border-radius: var(--radius-lg);
			box-shadow: var(--shadow-sm);

			@media (min-width: 640px) {
				flex-direction: row;
				align-items: stretch;
			}
		}

		&__imgWrap {
			flex-shrink: 0;
			aspect-ratio: 1 / 1;
			max-height: 40vh;
			width: 100%;
			border-radius: var(--radius-md);
			overflow: hidden;
			background: var(--c-grey-lightest);

			@media (min-width: 640px) {
				width: 260px;
				max-height: none;
			}
		}

		&__headerInfo {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			gap: 1.25rem;
			padding: 0.5rem 0.75rem 0.75rem;

			@media (min-width: 640px) {
				padding: 0.75rem 0.75rem 0.75rem 0;
			}
		}

		&__category {
			display: inline-block;
			margin-bottom: 0.75rem;
			padding: 4px 12px;
			font-size: 0.8rem;
			font-weight: 600;
			color: var(--c-secondary);
			background: var(--c-secondary-lightest);
			border-radius: var(--radius-full);

			&:first-letter {
				text-transform: uppercase;
			}
		}

		&__title {
			font-size: clamp(1.5rem, 3vw, 2rem);
			font-weight: 800;
			letter-spacing: -0.025em;
			line-height: 1.2;
			margin-bottom: 0.75rem;
		}

		&__authorBlock {
			display: flex;
			flex-wrap: wrap;
			gap: 6px;
			font-size: 0.9rem;
			color: var(--c-grey);
		}

		&__author {
			display: inline;
			font-style: normal;
			margin: 0;
		}

		&__related {
			padding: 0.85rem 1rem;
			font-size: 0.9rem;
			background: var(--c-primary-lightest);
			border-radius: var(--radius-md);

			:global(p) {
				margin: 0 !important;
				font-family: var(--font-primary) !important;
				color: var(--c-primary-darkest);
			}

			:global(a) {
				font-weight: 600;
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}

		&__aside {
			border-top: 1px solid var(--c-border);
			margin: 3rem 0 0;
			padding: 1.5rem 0 0;
		}
	}
</style>
