---
import { Category } from "@src/types/category";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { ui } from "@i18n/ui";
import { formatDate } from "@utils/formatDate";
import { authors } from "@src/content/_authors";
import ShareBlock from "@src/components/astro/ShareBlock/ShareBlock.astro";

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang, ui);
interface MetaInfo {
  age: string,
  priceRange: string,
}

type Author = {
  fullName: string;
  link: string;
}
interface Props {
  thumbnail: string;
  title: string;
  subtitle: string;
  content: any;
  category?: string;
  categorySlug?: Category;
  meta?: MetaInfo;
  author?: Author;
  date?: string;
  hasRelatedProducts?: boolean;
}

const { thumbnail, title, subtitle, content, category, categorySlug, meta, author, date, hasRelatedProducts = false } = Astro.props;
---

<article class="article" data-pagefind-body>
  <header class="article__header" data-category={categorySlug}>
    <div class="article__imgWrap">
      <slot name="thumbnail" class="article__img" />
    </div>

    <div class="article__headerInfo">
      <div>
        {category && <span class="article__category">{category}</span>}
        <h1 class="article__title">
          {title}{subtitle && <span class="article__subtitle"><span class="visually-hidden">: </span>{subtitle}</span>}
        </h1>
        {author &&
          <div class="article__authorBlock">
            <address class="article__author">{t("s.by")} <a rel="author" href={authors[author].link}>{authors[author].fullName}</a></address>
            <span aria-hidden="true">·</span>
            <time datetime={date}>{formatDate(date)}</time>
          </div>
        }
      </div>

      {hasRelatedProducts && (
        <div class="article__related">
          <slot name="related-products" />
        </div>
      )}
    </div>
  </header>

  <slot name="ads" />

  <div class="article__content prose">
    <slot name="content" />
  </div>

  <aside class="article__aside">
    <ShareBlock />
  </aside>
</article>

<style lang="scss">
	.article {
		max-width: 820px;

		&__header {

			position: relative;
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			margin-bottom: 2.75rem;
			padding: 14px;
			background: var(--cat, var(--c-primary-lightest));
			border: 2px solid var(--c-ink);
			border-radius: var(--radius-xl);
			box-shadow: 6px 6px 0 var(--c-ink);

			@media (min-width: 640px) {
				flex-direction: row;
				align-items: stretch;
				gap: 1.75rem;
			}
		}

		&__imgWrap {
			flex-shrink: 0;
			aspect-ratio: 1 / 1;
			max-height: 40vh;
			width: 100%;
			border: 2px solid var(--c-ink);
			border-radius: calc(var(--radius-xl) - 10px);
			overflow: hidden;
			background: var(--c-surface);

			@media (min-width: 640px) {
				width: 270px;
				max-height: none;
				transform: rotate(-2deg);
			}
		}

		&__headerInfo {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			gap: 1.25rem;
			min-width: 0;
			padding: 0.25rem 0.75rem 0.75rem;

			@media (min-width: 640px) {
				padding: 1rem 1rem 0.75rem 0;
			}
		}

		&__category {
			display: inline-block;
			margin-bottom: 1rem;
			padding: 5px 14px;
			font-size: 0.8rem;
			font-weight: 700;
			color: var(--c-ink);
			background: var(--c-surface);
			border: 2px solid var(--c-ink);
			border-radius: var(--radius-full);
			transform: rotate(-2deg);

			&:first-letter {
				text-transform: uppercase;
			}
		}

		&__title {
			font-size: clamp(1.6rem, 3.4vw, 2.35rem);
			font-weight: 700;
			letter-spacing: -0.04em;
			line-height: 1.08;
			margin-bottom: 1rem;
		}

		&__subtitle {
			display: block;
			margin-top: 0.6rem;
			font-family: var(--font-primary);
			font-size: clamp(1.05rem, 1.8vw, 1.25rem);
			font-weight: 500;
			letter-spacing: -0.01em;
			line-height: 1.4;
			color: var(--c-grey-dark);
		}

		&__authorBlock {
			display: flex;
			flex-wrap: wrap;
			gap: 6px;
			font-size: 0.9rem;
			color: var(--c-grey-dark);

			a {
				font-weight: 600;
				color: var(--c-ink);
				text-decoration: underline;
				text-decoration-color: var(--cat-ink, var(--c-primary-dark));
				text-underline-offset: 3px;
			}
		}

		&__author {
			display: inline;
			font-style: normal;
			margin: 0;
		}

		&__related {
			padding: 0.85rem 1rem;
			font-size: 0.9rem;
			background: var(--c-surface);
			border: 1px dashed var(--c-ink);
			border-radius: var(--radius-md);

			:global(p) {
				margin: 0 !important;
				font-family: var(--font-primary) !important;
				color: var(--c-ink);
			}

			:global(a) {
				font-weight: 600;
				color: var(--c-primary-dark);
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}

		&__aside {
			margin: 3rem 0 0;
		}
	}
</style>
