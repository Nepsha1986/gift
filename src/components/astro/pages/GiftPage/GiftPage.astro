---
import { Category } from "@src/types/category";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { ui } from "@i18n/ui";
import { formatDate } from "@utils/formatDate";
import { authors } from "@src/content/_authors";
import ShareBlock from "@src/components/astro/ShareBlock/ShareBlock.astro";

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang, ui);
interface MetaInfo {
  age: string,
  priceRange: string,
}

type Author = {
  fullName: string;
  link: string;
}
interface Props {
  thumbnail: string;
  title: string;
  subtitle: string;
  content: any;
  category?: string;
  categorySlug?: Category;
  meta?: MetaInfo;
  author?: Author;
  date?: string;
  hasRelatedProducts?: boolean;
}

const { thumbnail, title, subtitle, content, category, categorySlug, meta, author, date, hasRelatedProducts = false } = Astro.props;
---

<article class="article" data-pagefind-body>
  <header class="article__header" data-category={categorySlug}>
    <div class="article__imgWrap">
      <slot name="thumbnail" class="article__img" />
    </div>

    <div class="article__headerInfo">
      <div>
        {category && (
          <span class="article__category">
            <span class="article__categoryDot" aria-hidden="true"></span>
            {t("s.gift_idea")} · {category}
          </span>
        )}
        <h1 class="article__title">
          {title}{subtitle && <span class="article__subtitle"><span class="visually-hidden">: </span>{subtitle}</span>}
        </h1>
        {author &&
          <div class="article__authorBlock">
            <address class="article__author">{t("s.by")} <a rel="author" href={authors[author].link}>{authors[author].fullName}</a></address>
            <span aria-hidden="true">·</span>
            <time datetime={date}>{formatDate(date)}</time>
          </div>
        }
      </div>

      {hasRelatedProducts && (
        <div class="article__related">
          <slot name="related-products" />
        </div>
      )}
    </div>
  </header>

  <slot name="ads" />

  <div class="article__content prose">
    <slot name="content" />
  </div>

  <aside class="article__aside">
    <ShareBlock />
  </aside>
</article>

<style lang="scss">
	.article {
		max-width: 820px;

		// Editorial header: photo + headline straight on the page, no panel
		&__header {
			display: grid;
			gap: 1.75rem;
			margin-bottom: 2.75rem;
			padding-bottom: 2.25rem;
			border-bottom: 1px solid var(--c-border);

			@media (min-width: 640px) {
				grid-template-columns: 280px 1fr;
				align-items: center;
				gap: 2.25rem;
			}
		}

		&__imgWrap {
			aspect-ratio: 1 / 1;
			max-height: 42vh;
			width: 100%;
			overflow: hidden;
			border-radius: var(--radius-lg);
			background: var(--c-grey-lightest);
			box-shadow: var(--shadow-lg);

			@media (min-width: 640px) {
				max-height: none;
			}
		}

		&__headerInfo {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			min-width: 0;
		}

		&__category {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			margin-bottom: 1rem;
			font-size: 0.78rem;
			font-weight: 700;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--c-grey);
		}

		&__categoryDot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: var(--cat-ink, var(--c-primary));
		}

		&__title {
			font-size: clamp(2rem, 4.2vw, 3rem);
			font-weight: 600;
			letter-spacing: -0.015em;
			line-height: 1.05;
			margin-bottom: 1.25rem;
		}

		&__subtitle {
			display: block;
			margin-top: 0.75rem;
			font-family: var(--font-primary);
			font-size: clamp(1.05rem, 1.8vw, 1.25rem);
			font-weight: 400;
			letter-spacing: 0;
			line-height: 1.45;
			color: var(--c-grey);
			text-wrap: pretty;
		}

		&__authorBlock {
			display: flex;
			flex-wrap: wrap;
			gap: 6px;
			font-size: 0.9rem;
			color: var(--c-grey);

			a {
				font-weight: 600;
				color: var(--c-ink);

				&:hover {
					color: var(--c-primary-dark);
				}
			}
		}

		&__author {
			display: inline;
			font-style: normal;
			margin: 0;
		}

		&__related {
			padding: 0.9rem 1.1rem;
			font-size: 0.9rem;
			background: var(--c-surface);
			border: 1px solid var(--c-border);
			border-left: 3px solid var(--c-primary);
			border-radius: var(--radius-sm);

			:global(p) {
				margin: 0 !important;
				font-family: var(--font-primary) !important;
				color: var(--c-grey-dark);
			}

			:global(a) {
				font-weight: 600;
				color: var(--c-primary-dark);
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}

		&__aside {
			margin: 3rem 0 0;
		}
	}
</style>
