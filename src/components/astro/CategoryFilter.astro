---
import { getCollection } from "astro:content";
import { getCleanSlug, useTranslatedPath, useTranslations, getLocaleFromUrl, getLangFromUrl } from "@i18n/utils.ts";
import categoryTabs from "@i18n/translations/categoryTabs";
import { Category } from "@src/types/category";

const gifts = await getCollection("gifts");
const lang = getLangFromUrl(Astro.url.pathname);
const locale = getLocaleFromUrl(Astro.url.pathname);

const categories: Category[] = ["for-women", "for-men", "for-teens", "for-kids"];
const t = useTranslations(lang, categoryTabs);

const generateLinks = () => {
  let links: [string, Category][] = [];

  categories.forEach((category) => {
    const firstItem = gifts.find((i) => i.data.category?.includes(category));

    if (!!firstItem) {
      const firstItemSlug = firstItem?.slug;
      const translatePath = useTranslatedPath(locale);

      const link = translatePath(`/gifts/${category}/${getCleanSlug(firstItemSlug)}`);

      links.push([link, category]);
    }
  });

  return links;
};

const categoryLinks = generateLinks();

const { activeCategory } = Astro.props;
---

<nav class="categoryFilter">
  {categoryLinks.map((i) => {
    const isActive = activeCategory === i[1];

    return (
      <a class:list={["categoryFilter__link", { categoryFilter__link_active: isActive }]} href={i[0]} aria-current={isActive ? "page" : undefined}>
        {t(i[1])}
      </a>
    );
  })}
</nav>

<style lang="scss">
	.categoryFilter {
		display: flex;
		gap: 2px;
		overflow-x: auto;
		scrollbar-width: none;
		padding: 4px;
		background: var(--c-grey-lightest);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-full);

		&__link {
			flex: 1 0 auto;
			text-align: center;
			padding: 6px 10px;

			@media (max-width: 480px) {
				padding: 6px 7px;
			}
			font-size: 0.8rem;
			white-space: nowrap;
			font-weight: 600;
			line-height: 1.3;
			color: var(--c-grey);
			border-radius: var(--radius-full);
			transition: color 0.2s var(--ease), background-color 0.2s var(--ease);

			&:first-letter {
				text-transform: capitalize;
			}

			&:hover {
				color: var(--c-grey-darkest);
			}
		}

		&__link_active,
		&__link_active:hover {
			background: var(--c-surface);
			color: var(--c-primary-dark);
			box-shadow: var(--shadow-sm);
		}
	}
</style>
