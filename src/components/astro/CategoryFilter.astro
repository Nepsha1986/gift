---
import { getCollection } from "astro:content";
import { getCleanSlug, useTranslatedPath, useTranslations, getLocaleFromUrl, getLangFromUrl } from "@i18n/utils.ts";
import categoryTabs from "@i18n/translations/categoryTabs";
import { Category } from "@src/types/category";

const gifts = await getCollection("gifts");
const lang = getLangFromUrl(Astro.url.pathname);
const locale = getLocaleFromUrl(Astro.url.pathname);

const categories: Category[] = ["for-women", "for-men", "for-teens", "for-kids"];
const t = useTranslations(lang, categoryTabs);

const generateLinks = () => {
  let links: [string, Category][] = [];

  categories.forEach((category) => {
    const firstItem = gifts.find((i) => i.data.category?.includes(category));

    if (!!firstItem) {
      const firstItemSlug = firstItem?.slug;
      const translatePath = useTranslatedPath(locale);

      const link = translatePath(`/gifts/${category}/${getCleanSlug(firstItemSlug)}`);

      links.push([link, category]);
    }
  });

  return links;
};

const categoryLinks = generateLinks();

const { activeCategory } = Astro.props;
---

<nav class="categoryFilter">
  {categoryLinks.map((i) => {
    const isActive = activeCategory === i[1];

    return (
      <a class:list={["categoryFilter__link", { categoryFilter__link_active: isActive }]} href={i[0]} data-category={i[1]} aria-current={isActive ? "page" : undefined}>
        <span class="categoryFilter__dot" aria-hidden="true"></span>
        {t(i[1])}
      </a>
    );
  })}
</nav>

<style lang="scss">
	.categoryFilter {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 4px;
		padding: 5px;
		background: var(--c-surface);
		border: 2px solid var(--c-ink);
		border-radius: var(--radius-md);
		box-shadow: 3px 3px 0 var(--c-ink);

		&__link {
			flex: 1 0 auto;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 6px;
			padding: 8px 10px;
			font-size: 0.85rem;
			white-space: nowrap;
			font-weight: 600;
			line-height: 1.3;
			color: var(--c-grey);
			border-radius: var(--radius-sm);
			transition: color 0.2s var(--ease), background-color 0.2s var(--ease);

			&:hover {
				color: var(--c-ink);
				background: var(--c-grey-lightest);
			}
		}

		&__dot {
			width: 8px;
			height: 8px;
			flex-shrink: 0;
			border-radius: 50%;
			background: var(--cat);
			box-shadow: inset 0 0 0 1.5px var(--cat-ink);
		}

		&__link_active,
		&__link_active:hover {
			color: var(--c-ink);
			background: var(--cat);

			.categoryFilter__dot {
				background: var(--cat-ink);
			}
		}
	}
</style>
