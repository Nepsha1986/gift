---
import { Image } from "astro:assets";

interface Props {
  thumbnail: ImageMetadata;
  title: string;
  description: string;
  href: string;
  date: string;
  // "featured" fills the card with the photo and lays the text over it
  variant?: "default" | "featured";
  [key: string]: unknown;
}

const { thumbnail, title, description, href, date, variant = "default" } = Astro.props;
const isFeatured = variant === "featured";
---

<a href={href} class:list={["post-item", { "post-item_featured": isFeatured }]}>
  <div class="post-item__img">
    <Image
      class="img-cover"
      src={thumbnail}
      alt=""
      width={isFeatured ? 1200 : 640}
      height={isFeatured ? 900 : 400}
    />
  </div>

  <div class="post-item__content">
    <span class="post-item__date">{date}</span>

    <h3 class="post-item__title">{title}</h3>

    <p class="post-item__desc">{description}</p>
  </div>
</a>

<style lang="scss">
	@use "@src/styles/_mixins";

	.post-item {
		$this: &;

		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 8px;
		background: var(--c-surface);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-lg);
		transition:
			box-shadow 0.25s var(--ease),
			transform 0.3s var(--ease-bounce),
			border-color 0.2s var(--ease);

		&:hover {
			transform: translate(-2px, -2px);
			border-color: var(--c-ink);
			box-shadow: var(--shadow-pop);

			#{$this}__title {
				color: var(--c-primary-dark);
			}

			:global(img) {
				transform: scale(1.05);
			}
		}

		&__img {
			aspect-ratio: 16 / 10;
			overflow: hidden;
			border-radius: calc(var(--radius-lg) - 6px);
			background: var(--c-grey-lightest);

			:global(img) {
				transition: transform 0.6s var(--ease);
			}
		}

		&__content {
			display: flex;
			flex-direction: column;
			flex-grow: 1;
			padding: 14px 10px 10px;
		}

		&__date {
			align-self: flex-start;
			margin-bottom: 0.6rem;
			padding: 3px 10px;
			font-size: 0.75rem;
			font-weight: 600;
			color: var(--c-grey-dark);
			background: var(--c-grey-lightest);
			border-radius: var(--radius-full);
		}

		&__title {
			font-family: var(--font-primary);
			font-size: 1.15rem;
			font-weight: 700;
			letter-spacing: -0.015em;
			line-height: 1.3;
			margin-bottom: 0.5rem;
			transition: color 0.2s var(--ease);
			@include mixins.textOverflow(2);
		}

		&__desc {
			@include mixins.textOverflow(3);
			font-size: 0.925rem;
			line-height: 1.55;
			color: var(--c-grey);
			margin-bottom: 0;
		}

		// Phones: compact horizontal card (thumbnail + text)
		&:not(&_featured) {
			@media (max-width: 599px) {
				flex-direction: row;
				align-items: center;
				gap: 4px;
				border-radius: var(--radius-md);

				#{$this}__img {
					flex-shrink: 0;
					width: 104px;
					aspect-ratio: 1 / 1;
					border-radius: calc(var(--radius-md) - 4px);
				}

				#{$this}__content {
					padding: 2px 8px 2px 10px;
				}

				#{$this}__date {
					margin-bottom: 0.35rem;
					font-size: 0.7rem;
				}

				#{$this}__title {
					font-size: 1rem;
					margin-bottom: 0;
					-webkit-line-clamp: 3;
				}

				#{$this}__desc {
					display: none;
				}
			}
		}

		// Big cover story: photo fills the card, text sits on a dark fade
		&_featured {
			min-height: clamp(360px, 60vw, 420px);
			padding: 0;
			overflow: hidden;
			border: 2px solid var(--c-ink);
			background: var(--c-ink);

			#{$this}__img {
				position: absolute;
				inset: 0;
				aspect-ratio: auto;
				border-radius: 0;

				&::after {
					content: "";
					position: absolute;
					inset: 0;
					background: linear-gradient(180deg, rgba(29, 26, 36, 0) 30%, rgba(29, 26, 36, 0.92) 100%);
				}
			}

			#{$this}__content {
				position: relative;
				justify-content: flex-end;
				padding: clamp(1.25rem, 3vw, 2rem);
			}

			#{$this}__date {
				color: var(--c-ink);
				background: #ffd27a;
			}

			#{$this}__title {
				font-family: var(--font-secondary);
				font-size: clamp(1.4rem, 2.8vw, 2.1rem);
				font-weight: 600;
				letter-spacing: -0.035em;
				line-height: 1.12;
				color: #fff;
				-webkit-line-clamp: 3;
			}

			#{$this}__desc {
				max-width: 560px;
				font-size: 1rem;
				color: rgba(255, 255, 255, 0.82);
				-webkit-line-clamp: 2;
			}

			&:hover #{$this}__title {
				color: #fff;
			}
		}
	}
</style>
