---
import { Image } from "astro:assets";

const { thumbnail, title, description, href, date } = Astro.props;
---

<a href={href} class="post-item">
  <div class="post-item__img">
    <Image
      class="img-cover"
      src={thumbnail}
      alt=""
      width={640}
      height={400}
    />
  </div>

  <div class="post-item__content">
    <span class="post-item__date">{date}</span>

    <h2 class="post-item__title">{title}</h2>

    <p class="post-item__desc">{description}</p>
  </div>
</a>

<style lang="scss">
	@use "@src/styles/_mixins";

	.post-item {
		$this: &;

		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--c-surface);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		transition: box-shadow 0.25s var(--ease), transform 0.25s var(--ease), border-color 0.25s var(--ease);

		&:hover {
			transform: translateY(-3px);
			border-color: transparent;
			box-shadow: var(--shadow-lg);

			#{$this}__title {
				color: var(--c-primary-dark);
			}
		}

		&__img {
			aspect-ratio: 16 / 10;
			overflow: hidden;
			background: var(--c-grey-lightest);
		}

		&__content {
			display: flex;
			flex-direction: column;
			flex-grow: 1;
			padding: 1.1rem 1.25rem 1.35rem;
		}

		&__date {
			display: inline-block;
			margin-bottom: 0.5rem;
			font-size: 0.8rem;
			font-weight: 500;
			color: var(--c-grey);
		}

		&__title {
			font-size: 1.15rem;
			line-height: 1.35;
			margin-bottom: 0.5rem;
			transition: color 0.2s var(--ease);
			@include mixins.textOverflow(2);
		}

		&__desc {
			@include mixins.textOverflow(3);
			font-size: 0.925rem;
			line-height: 1.55;
			color: var(--c-grey);
			margin-bottom: 0;
		}
	}
</style>
