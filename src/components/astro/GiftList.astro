---
import { Image } from "astro:assets";
import GiftCard from "../react/GiftCard";
import { getCleanSlug, getLocaleFromUrl, useTranslatedPath } from "../../i18n/utils";
import { giftPath, type GiftEntry } from "@utils/gifts";

const { gifts, activeGiftSlug }: { gifts: GiftEntry[], activeGiftSlug: string } = Astro.props;
const translatePath = useTranslatedPath(getLocaleFromUrl(Astro.url.pathname));
---


<div class="giftList" id="gift_list">
  {gifts.map((i) => (
    <GiftCard
      key={i.slug}
      title={i.data.title}
      description={i.data.description}
      link={translatePath(giftPath(i))}
      active={getCleanSlug(i.slug) === activeGiftSlug}
      category={i.data.category}
    >
      <Image src={i.data.thumbnail} alt={i.data.title} class="img-cover" width="100" height="100" />
    </GiftCard>
  ))}
</div>
<style lang="scss">
	.giftList {
		@media (min-width: 1200px) {
			overflow-y: auto;
			max-height: calc(100vh - var(--header-height) - 100px);
			padding-right: 4px;
			scrollbar-width: thin;
		}
	}
</style>
<script>
  // Keep the open idea visible in the (scrollable) list instead of somewhere far below
  const centerIn = (container: HTMLElement | null, el: HTMLElement): void => {
    if (!container || container.scrollHeight <= container.clientHeight) return;

    const offset = el.getBoundingClientRect().top - container.getBoundingClientRect().top;
    container.scrollTop += offset - (container.clientHeight - el.clientHeight) / 2;
  };

  const revealActive = (): void => {
    const list = document.getElementById("gift_list");
    const active = list?.querySelector<HTMLElement>("[aria-current='page']");
    if (!list || !active) return;

    // Desktop: the list scrolls; mobile: the whole sidebar drawer scrolls
    centerIn(list, active);
    centerIn(document.getElementById("sidebar"), active);
  };

  document.addEventListener("astro:page-load", revealActive);
</script>
