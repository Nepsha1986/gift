---
interface Props {
  heading: string;
  eyebrow?: string;
  as?: "h1" | "h2";
}

const { heading, eyebrow, as: Heading = "h2" } = Astro.props;
---

<section class="section">
  <div class="section__container">
    <header class="section__header">
      {eyebrow && <span class="section__eyebrow">{eyebrow}</span>}
      <Heading class="section__heading">{heading}</Heading>

      {Astro.slots.has("subheading") && (
        <div class="section__subheading">
          <slot name="subheading" />
        </div>
      )}
    </header>

    <div class="section__content">
      <slot />
    </div>
  </div>
</section>

<style lang="scss" is:global>
	.section__subheading {
		p {
			font-size: 1.05rem;
			line-height: 1.65;
			color: var(--c-grey);
			margin-bottom: 0;
		}

		strong {
			color: var(--c-primary-dark);
		}
	}
</style>

<style lang="scss">
	.section {
		&__container {
			max-width: var(--container);
			height: 100%;
			padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) 0;
			margin: 0 auto;
		}

		&__header {
			text-align: center;
			max-width: 720px;
			margin: 0 auto 2.5rem;
		}

		&__eyebrow {
			display: inline-block;
			margin-bottom: 0.75rem;
			font-size: 0.8rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--c-secondary);
		}

		&__heading {
			font-size: clamp(1.75rem, 4vw, 2.5rem);
			font-weight: 800;
			letter-spacing: -0.03em;
			margin-bottom: 1rem;
		}
	}
</style>
