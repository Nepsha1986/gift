---
interface Props {
  heading: string;
  eyebrow?: string;
  as?: "h1" | "h2";
  id?: string;
  // "tinted" sets the section on a soft blush-to-peach panel
  tone?: "default" | "tinted";
}

const { heading, eyebrow, as: Heading = "h2", id, tone = "default" } = Astro.props;
---

<section class:list={["section", `section_${tone}`]} id={id}>
  <div class="section__container">
    <header class="section__header">
      <div class="section__titles">
        {eyebrow && <span class="section__eyebrow">{eyebrow}</span>}
        <Heading class="section__heading" set:html={heading} />

        {Astro.slots.has("subheading") && (
          <div class="section__subheading">
            <slot name="subheading" />
          </div>
        )}
      </div>

      {Astro.slots.has("action") && (
        <div class="section__action">
          <slot name="action" />
        </div>
      )}
    </header>

    <div class="section__content">
      <slot />
    </div>
  </div>
</section>

<style lang="scss" is:global>
	.section__subheading {
		p {
			font-size: 1.075rem;
			line-height: 1.6;
			color: var(--c-grey);
			margin-bottom: 0;
		}

		strong {
			color: var(--c-grey-darkest);
		}
	}
</style>

<style lang="scss">
	.section {
		scroll-margin-top: var(--header-height);

		&_tinted {
			margin: clamp(3rem, 7vw, 5.5rem) 10px 0;
			padding-bottom: clamp(3rem, 6vw, 4.5rem);
			background:
				radial-gradient(700px 400px at 100% 0%, rgba(255, 214, 170, 0.55), transparent 70%),
				linear-gradient(160deg, #fde3ea 0%, #fdf0ea 100%);
			border-radius: var(--radius-xl);
		}

		&__container {
			max-width: var(--container);
			height: 100%;
			padding: clamp(3rem, 7vw, 5.5rem) var(--gutter) 0;
			margin: 0 auto;
		}

		&__header {
			display: flex;
			flex-wrap: wrap;
			align-items: flex-end;
			justify-content: space-between;
			gap: 1rem 2rem;
			margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
		}

		&__titles {
			max-width: 680px;
		}

		&__eyebrow {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			margin-bottom: 0.9rem;
			font-size: 0.8rem;
			font-weight: 600;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--c-primary-dark);

			&::before {
				content: "";
				width: 22px;
				height: 2px;
				background: currentColor;
				border-radius: 2px;
			}
		}

		&__heading {
			font-size: clamp(1.85rem, 4.4vw, 3rem);
			font-weight: 600;
			letter-spacing: -0.015em;
			line-height: 1.05;
			margin-bottom: 0.75rem;

			&:last-child {
				margin-bottom: 0;
			}
		}
	}
</style>
