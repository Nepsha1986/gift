---
import FacebookShareBtn from './components/FacebookShareBtn.astro';
import TwitterShareBtn from './components/TwitterShareBtn.astro';
import TelegramShareBtn from './components/TelegramShareBtn.astro';
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { ui } from "@i18n/ui";

const t = useTranslations(getLangFromUrl(Astro.url.pathname), ui);
---

<div class="shareBlock">
  <span class="shareBlock__title">{t("s.share_with")}</span>
  <div class="shareBlock__buttons">
    <FacebookShareBtn />
    <TwitterShareBtn />
    <TelegramShareBtn />
  </div>
</div>

<style lang="scss">
	.shareBlock {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 14px 16px;
		padding: 1.25rem 1.5rem;
		background: var(--c-surface);
		border: 1px dashed var(--c-grey-light);
		border-radius: var(--radius-lg);

		&__title {
			font-family: var(--font-secondary);
			font-size: 1.05rem;
			font-weight: 600;
			letter-spacing: -0.02em;
			color: var(--c-ink);
		}

		&__buttons {
			display: flex;
			flex-wrap: wrap;
			gap: 8px;
		}
	}
</style>
