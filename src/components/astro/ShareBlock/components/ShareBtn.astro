---
interface Props {
  href: string;
  color?: string;
}

const { href, color = "currentColor", ...props }: Props = Astro.props;
---

<a class="shareBtn" style={{ "--brand": color }} href={href} target="_blank" rel="noopener" {...props}>
  <span class="shareBtn__icon">
    <slot name="icon" />
  </span>

  <slot />
</a>

<style lang="scss">
	.shareBtn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 38px;
		padding: 0 16px;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--c-grey-dark);
		background: var(--c-surface);
		border: 1px solid var(--c-border);
		border-radius: var(--radius-full);
		transition: border-color 0.2s var(--ease), color 0.2s var(--ease);

		&__icon {
			color: var(--brand);
			display: inline-flex;
		}

		&:hover {
			color: var(--c-grey-darkest);
			border-color: var(--brand);
		}
	}
</style>
