---
import classNames from "classnames";
interface Props {
  link: string;
  text: string;
  color?: "primary" | "secondary" | "outline";
}

const { link, text, color = "primary" } = Astro.props;

const className = classNames("linkButton", {
  [`linkButton_${color}`]: true
});
---

<a class={className} href={link}>
  {text}
  <span class="linkButton__arrow" aria-hidden="true">→</span>
</a>

<style lang="scss">
	.linkButton {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 52px;
		padding: 0 26px;
		font-size: 1rem;
		font-weight: 600;
		color: #fff;
		border: 1px solid var(--c-border);
		border-radius: var(--radius-full);
		box-shadow: var(--shadow-pop);
		transition:
			transform 0.25s var(--ease-bounce),
			box-shadow 0.25s var(--ease-bounce),
			background-color 0.2s var(--ease),
			color 0.2s var(--ease);

		&:first-letter {
			text-transform: uppercase;
		}

		&__arrow {
			transition: transform 0.2s var(--ease);
		}

		&:hover {
			transform: translateY(-4px);
			box-shadow: var(--shadow-lg);
		}

		&:hover &__arrow {
			transform: translateX(4px);
		}

		&:active {
			transform: translateY(0);
			box-shadow: var(--shadow-lg);
		}

		&_primary {
			background: var(--c-primary);
			border-color: transparent;
			box-shadow: var(--shadow-primary);

			&:hover {
				color: #fff;
				background: var(--c-primary-dark);
			}
		}

		&_secondary {
			background: var(--c-secondary);

			&:hover {
				color: #fff;
				background: var(--c-secondary-dark);
			}
		}

		&_outline {
			color: var(--c-ink);
			background: var(--c-surface);

			&:hover {
				color: var(--c-ink);
				border-color: var(--c-grey-light);
			}
		}
	}
</style>
