---
import classNames from "classnames";
interface Props {
  link: string;
  text: string;
  color?: "primary" | "secondary" | "outline";
}

const { link, text, color = "primary" } = Astro.props;

const className = classNames("linkButton", {
  [`linkButton_${color}`]: true
});
---

<a class={className} href={link}>
  {text}
  <span class="linkButton__arrow" aria-hidden="true">→</span>
</a>

<style lang="scss">
	.linkButton {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 52px;
		padding: 0 26px;
		font-size: 1rem;
		font-weight: 600;
		color: #fff;
		border: 2px solid var(--c-ink);
		border-radius: var(--radius-full);
		box-shadow: var(--shadow-pop);
		transition:
			transform 0.25s var(--ease-bounce),
			box-shadow 0.25s var(--ease-bounce),
			background-color 0.2s var(--ease),
			color 0.2s var(--ease);

		&:first-letter {
			text-transform: uppercase;
		}

		&__arrow {
			transition: transform 0.2s var(--ease);
		}

		&:hover {
			transform: translate(-2px, -2px);
			box-shadow: 6px 6px 0 var(--c-ink);
		}

		&:hover &__arrow {
			transform: translateX(4px);
		}

		&:active {
			transform: translate(2px, 2px);
			box-shadow: 1px 1px 0 var(--c-ink);
		}

		&_primary {
			background: var(--c-primary);

			&:hover {
				color: #fff;
				background: var(--c-primary-dark);
			}
		}

		&_secondary {
			background: var(--c-secondary);

			&:hover {
				color: #fff;
				background: var(--c-secondary-dark);
			}
		}

		&_outline {
			color: var(--c-ink);
			background: var(--c-surface);

			&:hover {
				color: var(--c-ink);
				background: #ffd27a;
			}
		}
	}
</style>
