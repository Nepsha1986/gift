---
import classNames from "classnames";
interface Props {
  link: string;
  text: string;
  color?: "primary" | "secondary" | "outline";
}

const { link, text, color = "primary" } = Astro.props;

const className = classNames("linkButton", {
  [`linkButton_${color}`]: true
});
---

<a class={className} href={link}>
  {text}
  <span class="linkButton__arrow" aria-hidden="true">→</span>
</a>

<style lang="scss">
	.linkButton {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 46px;
		padding: 0 24px;
		font-size: 0.95rem;
		font-weight: 600;
		color: #fff;
		border: 1px solid transparent;
		border-radius: var(--radius-full);
		transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease);

		&:first-letter {
			text-transform: uppercase;
		}

		&__arrow {
			transition: transform 0.2s var(--ease);
		}

		&:hover &__arrow {
			transform: translateX(3px);
		}

		&_primary {
			background: var(--c-primary);

			&:hover {
				color: #fff;
				background: var(--c-primary-dark);
			}
		}

		&_secondary {
			background: var(--c-secondary);

			&:hover {
				color: #fff;
				background: var(--c-secondary-dark);
			}
		}

		&_outline {
			color: var(--c-grey-darkest);
			background: var(--c-surface);
			border-color: var(--c-border);

			&:hover {
				color: var(--c-grey-darkest);
				border-color: var(--c-grey-light);
			}
		}
	}
</style>
